# Base URL of your CTFd instance (no trailing slash)
CTFD_URL=https://ctfd.example.com

# Admin credentials for first-time setup (optional if only detecting configured state)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Optional settings
PROJECT_NAME=CTF
TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=60
RETRY_BACKOFF_SECONDS=2
MAX_BACKOFF_SECONDS=30
JITTER=true
VERIFY_TLS=true

